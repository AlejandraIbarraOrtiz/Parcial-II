<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.rentcar.controller.ReservationController" spacing="12">
    <Label text="Reservations Management (Decorator Pattern)" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
        <Label text="Create New Reservation" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

        <GridPane hgap="12" vgap="10">
            <Label text="Select Rental Request:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="requestIdCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Decorators &amp; Dynamic Prices:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="gpsCheckBox" text="GPS Service"/>
                    <TextField fx:id="gpsPriceField" promptText="Price COP (e.g. 25000)" prefWidth="160"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="carSeatCheckBox" text="Car Seat Service"/>
                    <TextField fx:id="carSeatPriceField" promptText="Price COP (e.g. 18000)" prefWidth="160"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="driverCheckBox" text="Additional Driver Service"/>
                    <TextField fx:id="driverPriceField" promptText="Price COP (e.g. 35000)" prefWidth="160"/>
                </HBox>
            </VBox>

            <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Button text="Create Reservation" onAction="#createReservation" style="-fx-background-color: #2457a7; -fx-text-fill: white;"/>
                <Button text="Clear" onAction="#clearForm"/>
            </HBox>
        </GridPane>
        <Label text="Prices are fully dynamic and passed directly to the Decorators for recursive calculation." style="-fx-text-fill: #64748b;"/>
    </VBox>

    <Label text="Active Reservations" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

    <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="reservationIdColumn" text="Reservation ID" prefWidth="120"/>
            <TableColumn fx:id="requestIdColumn" text="Request ID" prefWidth="110"/>
            <TableColumn fx:id="customerIdColumn" text="Customer ID" prefWidth="110"/>
            <TableColumn fx:id="descriptionColumn" text="Description (Decorator Stack)" prefWidth="320"/>
            <TableColumn fx:id="totalPriceColumn" text="Total Calculated Price (COP)" prefWidth="180"/>
        </columns>
    </TableView>
</VBox>